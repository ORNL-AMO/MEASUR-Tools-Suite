/**
 * @defgroup insulated_pipe_reduction_calculator Insulated Pipe Reduction Calculator
 * @ingroup treasure_hunt_calculators
 * @brief Calculates heat loss per unit length and annual heat loss from a hot pipe,
 *        with or without thermal insulation.
 * @details This calculator estimates how much heat a hot pipe loses to the surrounding
 * air or how much heat infiltrates a cold pipe from the surrounding air, per unit length
 * and over a full operating year. Two cases are supported:
 * - **Insulated pipe** — the pipe is wrapped in an insulation layer of known thickness;
 *   heat must conduct through the pipe wall and the insulation before being dissipated
 *   to the air by convection and radiation at the jacket outer surface.
 * - **Bare (uninsulated) pipe** — no insulation is present; heat is dissipated directly
 *   from the pipe outer surface.
 *
 * Both cases use an iterative convergence loop that updates the outer surface temperature
 * and (for the insulated case) the pipe-insulation interface temperature on each pass
 * until the change in heat loss per unit length is less than 0.0001 W/m, or 30 iterations
 * are exceeded.
 *
 * The calculation follows these steps on each iteration:
 * 1. Compute air properties at the film temperature (mean of surface and ambient)
 *    using 4th-order polynomial fits to tabulated air-property data.
 * 2. Compute dimensionless numbers (Reynolds, Rayleigh) from the air properties and
 *    geometry.
 * 3. Evaluate forced- and free-convection Nusselt numbers using the Churchill–Bernstein
 *    and Churchill–Chu correlations respectively, then combine them.
 * 4. Derive the combined convective heat transfer coefficient and add the linearized
 *    radiative heat transfer coefficient.
 * 5. Compute cylindrical thermal resistances for the pipe wall and (if present) the
 *    insulation layer.
 * 6. Sum all resistances, compute total heat flow, and update surface and interface
 *    temperatures.
 * 7. Check convergence on heat loss per unit length; if converged, return the average
 *    of the previous and current values.
 *
 * Annual heat loss or gain is obtained by multiplying the converged per-length value by pipe
 * length, annual operating hours, and the reciprocal of system efficiency.
 *
 * Relevant formulas and symbol definitions are documented below.
 *
 * @heading{Thermal Resistance of a Cylindrical Shell}
 * @copydoc insulated_pipe_reduction_thermal_resistance_formula
 *
 * @heading{Reynolds Number}
 * @copydoc insulated_pipe_reduction_reynolds_formula
 *
 * @heading{Rayleigh Number}
 * @copydoc insulated_pipe_reduction_rayleigh_formula
 *
 * @heading{Forced Convection Nusselt Number (Churchill–Bernstein)}
 * @copydoc insulated_pipe_reduction_nusselt_forced_formula
 *
 * @heading{Free Convection Nusselt Number (Churchill–Chu)}
 * @copydoc insulated_pipe_reduction_nusselt_free_formula
 *
 * @heading{Combined Nusselt Number}
 * @copydoc insulated_pipe_reduction_nusselt_formula
 *
 * @heading{Convective Heat Transfer Coefficient}
 * @copydoc insulated_pipe_reduction_convection_formula
 *
 * @heading{Radiative Heat Transfer Coefficient}
 * @copydoc insulated_pipe_reduction_radiation_formula
 *
 * @heading{Insulated Pipe Heat Loss per Unit Length}
 * @copydoc insulated_pipe_reduction_insulated_formula
 *
 * @heading{Bare Pipe Heat Loss per Unit Length}
 * @copydoc insulated_pipe_reduction_bare_formula
 *
 * @heading{Annual Heat Loss}
 * @copydoc insulated_pipe_reduction_annual_formula
 */

/**
 * @defgroup insulated_pipe_reduction_thermal_resistance_formula Thermal Resistance Formula
 * @ingroup insulated_pipe_reduction_calculator
 * @brief Thermal resistance per unit length of a cylindrical shell.
 * @details The resistance to heat flow through a hollow cylinder (pipe wall or insulation
 * annulus) depends on the ratio of its outer to inner radius and on the thermal conductivity
 * of the material. The formula accounts for the geometry of radial heat conduction through
 * a cylindrical shell.
 *
 * @formula{insulated-pipe-thermal-resistance; R = \frac{d_a \ln\!\left(\frac{d_b}{d_c}\right)}{2 k}}
 *
 * @subheading{Symbols}
 * @symtable
 * @symrow{R; Thermal resistance per unit length; \meter\kelvin\per\watt}
 * @symrow{d_a; Outer diameter of the shell; \meter}
 * @symrow{d_b; Outer boundary diameter of the conductive layer; \meter}
 * @symrow{d_c; Inner boundary diameter of the conductive layer; \meter}
 * @symrow{k; Thermal conductivity of the shell material; \watt\per\meter\per\kelvin}
 * @endsymtable
 */

/**
 * @defgroup insulated_pipe_reduction_reynolds_formula Reynolds Number Formula
 * @ingroup insulated_pipe_reduction_calculator
 * @brief Reynolds number for external cross-flow over a cylinder.
 * @details The Reynolds number characterizes the flow regime (laminar vs. turbulent) of
 * the wind passing over the pipe or insulation jacket. It is used to determine the
 * forced-convection Nusselt number.
 *
 * @formula{insulated-pipe-reynolds; \mathrm{Re} = \frac{d \cdot v}{\nu}}
 *
 * @subheading{Symbols}
 * @symtable
 * @symrow{\mathrm{Re}; Reynolds number; \unitless}
 * @symrow{d; Outer diameter of the surface (pipe or insulation jacket); \meter}
 * @symrow{v; Free-stream wind velocity; \meter\per\second}
 * @symrow{\nu; Kinematic viscosity of air at the film temperature; \meter\squared\per\second}
 * @endsymtable
 */

/**
 * @defgroup insulated_pipe_reduction_rayleigh_formula Rayleigh Number Formula
 * @ingroup insulated_pipe_reduction_calculator
 * @brief Rayleigh number for natural convection from a horizontal cylinder.
 * @details The Rayleigh number drives the free-convection heat transfer. It combines the
 * buoyancy force (from the temperature difference between surface and air) with the
 * fluid's resistance to motion (viscosity) and heat diffusion (thermal diffusivity).
 *
 * @formula{insulated-pipe-rayleigh; \mathrm{Ra} = \frac{g \beta \left|T_s - T_\infty\right| d^3}{\nu \alpha}}
 *
 * @subheading{Symbols}
 * @symtable
 * @symrow{\mathrm{Ra}; Rayleigh number; \unitless}
 * @symrow{g; Gravitational acceleration (9.81); \meter\per\second\squared}
 * @symrow{\beta; Volumetric thermal expansion coefficient of air (1/@math{T_{film}}); \per\kelvin}
 * @symrow{T_s; Outer surface temperature; \kelvin}
 * @symrow{T_\infty; Ambient air temperature; \kelvin}
 * @symrow{d; Outer diameter of the surface; \meter}
 * @symrow{\nu; Kinematic viscosity of air at the film temperature; \meter\squared\per\second}
 * @symrow{\alpha; Thermal diffusivity of air at the film temperature; \meter\squared\per\second}
 * @endsymtable
 */

/**
 * @defgroup insulated_pipe_reduction_nusselt_forced_formula Forced-Convection Nusselt Number Formula
 * @ingroup insulated_pipe_reduction_calculator
 * @brief Churchill–Bernstein correlation for forced convection over a cylinder in cross-flow.
 * @details This empirical correlation is valid over a wide range of Reynolds and Prandtl
 * numbers and is recommended for external flow over cylinders.
 *
 * @formula{insulated-pipe-nusselt-forced;
 *   \mathrm{Nu}_{forced} = 0.3 +
 *   \frac{0.62\,\mathrm{Re}^{1/2}\,\mathrm{Pr}^{1/3}}
 *        {\left[1+\left(\frac{0.4}{\mathrm{Pr}}\right)^{2/3}\right]^{1/4}}
 *   \left[1+\left(\frac{\mathrm{Re}}{282000}\right)^{5/8}\right]^{4/5}
 * }
 *
 * @subheading{Symbols}
 * @symtable
 * @symrow{\mathrm{Nu}_{forced}; Forced-convection Nusselt number; \unitless}
 * @symrow{\mathrm{Re}; Reynolds number; \unitless}
 * @symrow{\mathrm{Pr}; Prandtl number of air at the film temperature; \unitless}
 * @endsymtable
 */

/**
 * @defgroup insulated_pipe_reduction_nusselt_free_formula Free-Convection Nusselt Number Formula
 * @ingroup insulated_pipe_reduction_calculator
 * @brief Churchill–Chu correlation for free convection from a horizontal cylinder.
 * @details This correlation is recommended for natural convection from long horizontal
 * cylinders over the full range of Rayleigh numbers.
 *
 * @formula{insulated-pipe-nusselt-free;
 *   \mathrm{Nu}_{free} = \left[0.6 +
 *   \frac{0.387\,\mathrm{Ra}^{1/6}}
 *        {\left[1+\left(\frac{0.559}{\mathrm{Pr}}\right)^{9/16}\right]^{8/27}}
 *   \right]^2
 * }
 *
 * @subheading{Symbols}
 * @symtable
 * @symrow{\mathrm{Nu}_{free}; Free-convection Nusselt number; \unitless}
 * @symrow{\mathrm{Ra}; Rayleigh number; \unitless}
 * @symrow{\mathrm{Pr}; Prandtl number of air at the film temperature; \unitless}
 * @endsymtable
 */

/**
 * @defgroup insulated_pipe_reduction_nusselt_formula Combined Nusselt Number Formula
 * @ingroup insulated_pipe_reduction_calculator
 * @brief Power-sum combination of forced and free convection Nusselt numbers.
 * @details When both forced and free convection are present simultaneously, the two
 * contributions are combined using a fourth-power sum rule. The exponent of four gives
 * a smooth transition between forced-dominated and buoyancy-dominated regimes.
 *
 * @formula{insulated-pipe-nusselt-combined;
 *   \mathrm{Nu} = \left(\mathrm{Nu}_{forced}^4 + \mathrm{Nu}_{free}^4\right)^{1/4}
 * }
 *
 * @subheading{Symbols}
 * @symtable
 * @symrow{\mathrm{Nu}; Combined Nusselt number; \unitless}
 * @symrow{\mathrm{Nu}_{forced}; Forced-convection Nusselt number; \unitless}
 * @symrow{\mathrm{Nu}_{free}; Free-convection Nusselt number; \unitless}
 * @endsymtable
 */

/**
 * @defgroup insulated_pipe_reduction_convection_formula Convective Heat Transfer Coefficient Formula
 * @ingroup insulated_pipe_reduction_calculator
 * @brief Convective heat transfer coefficient from the Nusselt number definition.
 * @details The Nusselt number is the ratio of convective to conductive heat transfer at the
 * surface, so rearranging its definition gives the convective heat transfer coefficient directly.
 *
 * @formula{insulated-pipe-convection; h_{conv} = \frac{\mathrm{Nu} \cdot k_{air}}{d}}
 *
 * @subheading{Symbols}
 * @symtable
 * @symrow{h_{conv}; Convective heat transfer coefficient; \watt\per\meter\squared\per\kelvin}
 * @symrow{\mathrm{Nu}; Combined Nusselt number; \unitless}
 * @symrow{k_{air}; Thermal conductivity of air at the film temperature; \watt\per\meter\per\kelvin}
 * @symrow{d; Outer diameter of the surface; \meter}
 * @endsymtable
 */

/**
 * @defgroup insulated_pipe_reduction_radiation_formula Radiative Heat Transfer Coefficient Formula
 * @ingroup insulated_pipe_reduction_calculator
 * @brief Linearized radiative heat transfer coefficient from the Stefan–Boltzmann law.
 * @details The full Stefan–Boltzmann radiation term is divided by the temperature difference
 * to produce a linearized coefficient that can be added directly to the convective coefficient.
 * This linearization is valid when the temperature difference is small relative to the absolute
 * temperatures involved.
 *
 * @formula{insulated-pipe-radiation;
 *   h_{rad} = \frac{\sigma \varepsilon \left(T_s^4 - T_\infty^4\right)}{T_s - T_\infty}
 * }
 *
 * @subheading{Symbols}
 * @symtable
 * @symrow{h_{rad}; Radiative heat transfer coefficient; \watt\per\meter\squared\per\kelvin}
 * @symrow{\sigma; Stefan–Boltzmann constant (5.670373 × 10⁻⁸); \watt\per\meter\squared\per\kelvin\tothe{4}}
 * @symrow{\varepsilon; Surface emissivity (0–1); \unitless}
 * @symrow{T_s; Outer surface temperature; \kelvin}
 * @symrow{T_\infty; Ambient air temperature; \kelvin}
 * @endsymtable
 */

/**
 * @defgroup insulated_pipe_reduction_insulated_formula Insulated Pipe Heat Loss Formula
 * @ingroup insulated_pipe_reduction_calculator
 * @brief Heat loss per unit length for an insulated pipe.
 * @details The pipe inner surface (fluid) temperature drives heat through three resistances
 * in series: the pipe wall, the insulation annulus, and the combined air-film resistance
 * at the jacket outer surface. The air-film resistance is the reciprocal of the sum of
 * convective and radiative heat transfer coefficients. All resistances are per unit length.
 *
 * @formula{insulated-pipe-insulated-resistance; R_{total} = R_{pipe} + R_{ins} + \frac{1}{h_{air}}}
 * @formula{insulated-pipe-insulated-heat-flow; q = \frac{T_{pipe} - T_\infty}{R_{total}}}
 * @formula{insulated-pipe-insulated-heat-length; q_L = q \cdot \pi \cdot d_{ins,outer}}
 *
 * @subheading{Symbols}
 * @symtable
 * @symrow{R_{total}; Total thermal resistance per unit length; \meter\kelvin\per\watt}
 * @symrow{R_{pipe}; Pipe wall thermal resistance per unit length; \meter\kelvin\per\watt}
 * @symrow{R_{ins}; Insulation thermal resistance per unit length; \meter\kelvin\per\watt}
 * @symrow{h_{air}; Combined air-film heat transfer coefficient (@math{h_{conv}} + @math{h_{rad}}); \watt\per\meter\squared\per\kelvin}
 * @symrow{q; Heat flow per unit area; \watt\per\meter\squared}
 * @symrow{T_{pipe}; Pipe inner surface (fluid) temperature; \kelvin}
 * @symrow{T_\infty; Ambient air temperature; \kelvin}
 * @symrow{q_L; Heat loss per unit length; \watt\per\meter}
 * @symrow{d_{ins,outer}; Insulation jacket outer diameter; \meter}
 * @symrow{\pi; Mathematical constant pi; \unitless}
 * @endsymtable
 */

/**
 * @defgroup insulated_pipe_reduction_bare_formula Bare Pipe Heat Loss Formula
 * @ingroup insulated_pipe_reduction_calculator
 * @brief Heat loss per unit length for a bare (uninsulated) pipe.
 * @details Without insulation, heat conducts through the pipe wall only before being
 * dissipated from the bare outer surface. The formula is identical to the insulated case
 * except that the insulation resistance is absent and the air-film resistance acts
 * directly on the pipe outer surface.
 *
 * @formula{insulated-pipe-bare-resistance; R_{total} = R_{pipe} + \frac{1}{h_{air}}}
 * @formula{insulated-pipe-bare-heat-flow; q = \frac{T_{pipe} - T_\infty}{R_{total}}}
 * @formula{insulated-pipe-bare-heat-length; q_L = q \cdot \pi \cdot d_{pipe}}
 *
 * @subheading{Symbols}
 * @symtable
 * @symrow{R_{total}; Total thermal resistance per unit length; \meter\kelvin\per\watt}
 * @symrow{R_{pipe}; Pipe wall thermal resistance per unit length; \meter\kelvin\per\watt}
 * @symrow{h_{air}; Combined air-film heat transfer coefficient (@math{h_{conv}} + @math{h_{rad}}); \watt\per\meter\squared\per\kelvin}
 * @symrow{q; Heat flow per unit area; \watt\per\meter\squared}
 * @symrow{T_{pipe}; Pipe inner surface (fluid) temperature; \kelvin}
 * @symrow{T_\infty; Ambient air temperature; \kelvin}
 * @symrow{q_L; Heat loss per unit length; \watt\per\meter}
 * @symrow{d_{pipe}; Pipe outer diameter; \meter}
 * @symrow{\pi; Mathematical constant pi; \unitless}
 * @endsymtable
 */

/**
 * @defgroup insulated_pipe_reduction_annual_formula Annual Heat Loss Formula
 * @ingroup insulated_pipe_reduction_calculator
 * @brief Annual heat loss for the full pipe length.
 * @details The converged heat loss per unit length is scaled by pipe length and annual
 * operating time. Dividing by system efficiency converts heat loss at the pipe surface
 * to the equivalent heat input required from the heating system.
 *
 * @formula{insulated-pipe-annual; Q_{annual} = \frac{q_L \cdot L \cdot t_{op}}{\eta}}
 *
 * @subheading{Symbols}
 * @symtable
 * @symrow{Q_{annual}; Annual heat loss; \watt\hour\per\year}
 * @symrow{q_L; Converged heat loss per unit length; \watt\per\meter}
 * @symrow{L; Total pipe length; \meter}
 * @symrow{t_{op}; Annual operating hours; \hour\per\year}
 * @symrow{\eta; Heating system efficiency (0–1); \unitless}
 * @endsymtable
 */
