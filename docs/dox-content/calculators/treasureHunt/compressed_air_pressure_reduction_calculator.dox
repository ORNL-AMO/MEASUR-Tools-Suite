/**
 * @defgroup compressed_air_pressure_reduction_calculator Compressed Air Pressure Reduction Calculator
 * @ingroup treasure_hunt_calculators
 * @brief Quantifies electricity savings from reducing compressed air system pressure.
 * @details This calculator can be used to quantify the electricity saved from reducing compressed air
 * system pressure. The benefits of lowering system pressure are twofold:
 * 1. **Reduced compressor work** — Lower pressure reduces compressor work and therefore reduces
 *    electrical demand.
 * 2. **Reduced airflow losses** — Lower pressure reduces delivered airflow and therefore reduces
 *    losses from artificial demand and air leaks.
 *
 * This calculator only estimates electricity savings at compressors. These savings are not applicable
 * when compressed air is supplied from an external source.
 *
 * @note This calculator is not valid for centrifugal compressors.
 *
 * The calculation estimates annual electrical energy use and annual energy cost for compressed-air
 * systems evaluated during treasure hunt activities. It supports a baseline mode and a modification
 * mode, and the baseline mode includes two power-entry options:
 * 1. **Baseline (Measured Power)** — Uses measured compressor power and annual operating hours directly.
 * 2. **Baseline (Rated Power)** — Uses rated (or otherwise estimated) compressor power and annual operating hours directly.
 * 3. **Modification** — Uses proposed pressure, atmospheric pressure, and rated pressure to estimate adjusted power.
 *
 * For each measure, the selected mode computes annual energy use and annual energy cost, then totals are
 * accumulated across all measures.
 *
 * @heading{Baseline Energy Use}
 * @copydoc compressed_air_pressure_reduction_baseline_energy_formula
 *
 * @heading{Modification Energy Use}
 * @copydoc compressed_air_pressure_reduction_modification_energy_formula
 *
 * @heading{Energy Cost}
 * @copydoc compressed_air_pressure_reduction_energy_cost_formula
 */

/**
 * @defgroup compressed_air_pressure_reduction_baseline_energy_formula Baseline Energy Use Formula
 * @ingroup compressed_air_pressure_reduction_calculator
 * @brief Annual energy use for baseline compressed-air operation using measured or rated power.
 * @details The baseline calculation accepts compressor power as a direct input and applies the same
 * equation for both baseline options:
 * 1. **Measured Power baseline** — @math{P_{comp}} is measured compressor power.
 * 2. **Rated Power baseline** — @math{P_{comp}} is rated compressor power.
 *
 * In both cases, annual energy use is compressor power multiplied by annual operating hours.
 *
 * @formula{compressed-air-pressure-reduction-baseline-energy; E_{use} = P_{comp} \cdot t_{op}}
 *
 * @subheading{Symbols}
 * @symtable
 * @symrow{E_{use}; Annual energy use; \kWh\per\year}
 * @symrow{P_{comp}; Compressor power; \kW}
 * @symrow{t_{op}; Annual operating hours; \hour\per\year}
 * @endsymtable
 */

/**
 * @defgroup compressed_air_pressure_reduction_modification_energy_formula Modification Energy Use Formula
 * @ingroup compressed_air_pressure_reduction_calculator
 * @brief Annual energy use for pressure-reduction modification.
 * @details First estimate modification power from pressure terms, then multiply by annual operating hours.
 * The ratio @math{x} converts the proposed pressure from gauge (psig) to absolute (psia) using the
 * user-supplied atmospheric pressure @math{P_{atm}}. The ratio @math{r} converts the rated compressor
 * pressure from psig to psia using an assumed standard atmospheric pressure of @math{14.7}
 * @unitb{\psi}. The exponent @math{c = (k-1)/k} is the isentropic exponent derived from the heat
 * capacity ratio @math{k = 1.395} for air (ratio of specific heats @math{c_p/c_v}).
 *
 * @formula{compressed-air-pressure-reduction-modification-power; P_{mod} = P_{comp} \cdot \frac{x^c - 1}{r^c - 1}}
 * @formula{compressed-air-pressure-reduction-modification-ratio-x; x = \frac{P_{proposed} + P_{atm}}{P_{atm}}}
 * @formula{compressed-air-pressure-reduction-modification-ratio-r; r = \frac{P_{rated} + 14.7}{14.7}}
 * @formula{compressed-air-pressure-reduction-modification-c; c = \frac{k-1}{k}}
 * @formula{compressed-air-pressure-reduction-modification-energy; E_{use} = P_{mod} \cdot t_{op}}
 *
 * @subheading{Symbols}
 * @symtable
 * @symrow{E_{use}; Annual energy use; \kWh\per\year}
 * @symrow{P_{mod}; Modification compressor power estimate; \kW}
 * @symrow{P_{comp}; Compressor power; \kW}
 * @symrow{P_{proposed}; Proposed compressor discharge pressure (psig); \psi}
 * @symrow{P_{atm}; Atmospheric pressure (user-supplied, converts psig to psia); \psi}
 * @symrow{P_{rated}; Rated compressor discharge pressure (psig); \psi}
 * @symrow{14.7; Assumed standard atmospheric pressure (converts @math{P_{rated}} from psig to psia); \psi}
 * @symrow{x; Proposed absolute pressure ratio; \unitless}
 * @symrow{r; Rated absolute pressure ratio; \unitless}
 * @symrow{c; Isentropic exponent, (k-1)/k; \unitless}
 * @symrow{k; Heat capacity ratio of air, c_p/c_v (1.395); \unitless}
 * @symrow{t_{op}; Annual operating hours; \hour\per\year}
 * @endsymtable
 */

/**
 * @defgroup compressed_air_pressure_reduction_energy_cost_formula Energy Cost Formula
 * @ingroup compressed_air_pressure_reduction_calculator
 * @brief Annual energy cost from annual energy use and electricity rate.
 *
 * @formula{compressed-air-pressure-reduction-energy-cost; C_{energy} = E_{use} \cdot r_{elec}}
 *
 * @subheading{Symbols}
 * @symtable
 * @symrow{C_{energy}; Annual energy cost; \dollar\per\year}
 * @symrow{E_{use}; Annual energy use; \kWh\per\year}
 * @symrow{r_{elec}; Electricity cost rate; \dollar\per\kWh}
 * @endsymtable
 */
