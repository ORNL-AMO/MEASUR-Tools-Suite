/**
 * @page positive_displacement_pump_calculator Positive Displacement Pump Calculator
 * @ingroup pumping_system_assessments
 *
 * @brief Estimates positive displacement pump power and annual energy use from flow rate and differential pressure.
 *
 * @details This calculator supports Pump Inventory entries for positive displacement pumps. It uses the pump
 * differential pressure directly instead of total dynamic head.
 *
 * @formula{positive-displacement-pump-power; P = \frac{Q \Delta p}{1714.231 \eta} \times 0.746}
 * @formula{positive-displacement-pump-energy; E = P h}
 *
 * where:
 * @symtable
 * @symrow{P; pump power; \kilo\watt}
 * @symrow{Q; volumetric flow rate; \gallon\per\minute}
 * @symrow{\Delta p; pump differential pressure; \PSI}
 * @symrow{\eta; pump efficiency as a fraction; 1}
 * @symrow{h; annual operating hours; \hour\per\year}
 * @symrow{E; annual energy use; \kilo\watt\hour\per\year}
 * @endsymtable
 */
