/**
 * @defgroup compressor_catalog_units Compressor Catalog Units
 * @ingroup compressor_modeling_utilities
 * @brief Field units for compressor catalog records.
 * @details The compressor catalog is a lookup table of default compressor records. Each
 *          record supplies the rated size, control type, pressure, airflow, power, and design
 *          values used to prefill compressor assessment inputs when site-specific data are not
 *          available. The table below lists the units for each catalog field.
 *
 * @heading{Field Units}
 * @symtable
 * @symrow{id; Sequential catalog record identifier; \unitless}
 * @symrow{compressorTypeId; Compressor type identifier; \unitless}
 * @symrow{model; Catalog model label; \unitless}
 * @symrow{horsepower; Rated motor size; \hp}
 * @symrow{ratedCapacityAcfm; Rated compressor capacity; \acfm}
 * @symrow{ratedPressurePsig; Rated discharge pressure; \psig}
 * @symrow{maxFullFlowPressurePsig; Maximum full-flow pressure; \psig}
 * @symrow{controlTypeId; Control type identifier; \unitless}
 * @symrow{unloadPointPercent; Unload point; \percent}
 * @symrow{minUnloadSumpPressurePsig; Minimum unload sump pressure; \psig}
 * @symrow{blowdownTimeSec; Blowdown time; \second}
 * @symrow{unloadSteps; Number of unload steps; \unitless}
 * @symrow{modulatingPressureRangePsig; Modulating pressure range; \psig}
 * @symrow{fullLoadBhpPowerKw; Full-load brake-horsepower equivalent power; \kilo\watt}
 * @symrow{totalPackageInputPowerKw; Total package input power; \kilo\watt}
 * @symrow{specificPackagePower; Specific package power; \kilo\watt\per\acfm}
 * @symrow{noLoadPowerFullyModulating; No-load fully modulating power fraction; \unitless}
 * @symrow{noLoadPowerUnload; No-load unload power fraction; \unitless}
 * @symrow{maxSurgePressurePsig; Maximum surge pressure; \psig}
 * @symrow{maxSurgePressureFlowAcfm; Flow at maximum surge pressure; \acfm}
 * @symrow{minStonewallPressurePsig; Minimum stonewall pressure; \psig}
 * @symrow{minStonewallPressureFlowAcfm; Flow at minimum stonewall pressure; \acfm}
 * @symrow{designSurgeFlowAcfm; Design surge flow; \acfm}
 * @symrow{designInletTemperatureF; Design inlet temperature; \degreeFahrenheit}
 * @symrow{designInletPressurePsia; Design inlet pressure; \psia}
 * @symrow{fullLoadAmps; Full-load current; \ampere}
 * @symrow{fullLoadEfficiencyPercent; Full-load efficiency; \percent}
 * @endsymtable
 *
 * @note Numeric record IDs identify the catalog rows after the default data set is loaded.
 *       They are identifiers only and do not carry engineering units.
 */
