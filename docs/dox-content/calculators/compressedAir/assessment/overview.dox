/**
 * @defgroup compressor_modeling_overview Compressor Modeling Overview
 * @ingroup compressor_assessment_modeling
 * @brief Shared compressor modeling outputs, electrical measurement conversion, and pressure/inlet correction.
 * @details The compressor assessment models estimate two practical operating quantities:
 *          how much electrical power a compressor package uses and how much compressed air it
 *          delivers. The same result format is used for centrifugal, modulation, start/stop,
 *          load/unload, and variable-frequency-drive controls. Results are reported as
 *          calculated package power @unitb{\kilo\watt}, calculated airflow @unitb{\acfm},
 *          power fraction @unitb{\unitless}, and airflow fraction @unitb{\unitless}.
 *
 * A fraction is the operating value divided by the full-load reference value. For example,
 * a power fraction of 0.75 means the compressor is using 75 percent of its full-load
 * package power, and an airflow fraction of 0.60 means it is delivering 60 percent of
 * its full-load airflow.
 *
 * @heading{Common Result Definitions}
 * @copydoc compressor_assessment_result_formula
 *
 * @heading{Common Electrical Input Conversion}
 * @copydoc compressor_assessment_electrical_formula
 *
 * @heading{Common Pressure and Inlet Correction}
 * @copydoc compressor_assessment_pressure_inlet_formula
 */

/**
 * @defgroup compressor_assessment_result_formula Compressor Assessment Result Formula
 * @ingroup compressor_modeling_overview
 * @brief Converting operating fractions into package power and delivered airflow.
 * @details Each compressor control model first finds the operating point as a fraction of
 *          full load. The final reported power and airflow are found by multiplying those
 *          fractions by the full-load package power and full-load airflow. This keeps the
 *          control-specific part of each model focused on the shape of the compressor curve.
 *
 * @formula{compressor-assessment-result-power;
 *   P_{calc} = f_P \cdot P_{FL}
 * }
 * @formula{compressor-assessment-result-airflow;
 *   Q_{calc} = f_Q \cdot Q_{FL}
 * }
 *
 * @subheading{Symbols}
 * @symtable
 * @symrow{P_{calc}; Calculated compressor package power; \kilo\watt}
 * @symrow{Q_{calc}; Calculated compressor airflow; \acfm}
 * @symrow{f_P; Fraction of full-load package power; \unitless}
 * @symrow{f_Q; Fraction of full-load airflow; \unitless}
 * @symrow{P_{FL}; Full-load package power; \kilo\watt}
 * @symrow{Q_{FL}; Full-load airflow; \acfm}
 * @endsymtable
 */

/**
 * @defgroup compressor_assessment_electrical_formula Compressor Assessment Electrical Formula
 * @ingroup compressor_modeling_overview
 * @brief Three-phase electrical measurement conversion.
 * @details When field data are supplied as line voltage, current, and power factor, the
 *          first step is to convert those electrical measurements into package power. The
 *          compressor model then treats that power in the same way it would treat a measured
 *          kilowatt value. The constant 1.732 is the square root of three rounded to the
 *          value used by the original assessment method.
 *
 * @formula{compressor-assessment-electrical-power;
 *   P_{meas} = \frac{V \cdot I \cdot PF \cdot 1.732}{1000}
 * }
 *
 * @subheading{Symbols}
 * @symtable
 * @symrow{P_{meas}; Measured three-phase package power; \kilo\watt}
 * @symrow{V; Line voltage; \volt}
 * @symrow{I; Current; \ampere}
 * @symrow{PF; Power factor; \unitless}
 * @symrow{1.732; Legacy square-root-of-three constant; \unitless}
 * @symrow{1000; Watt-to-kilowatt conversion; \watt\per\kilo\watt}
 * @endsymtable
 */

/**
 * @defgroup compressor_assessment_pressure_inlet_formula Compressor Assessment Pressure Inlet Correction
 * @ingroup compressor_modeling_overview
 * @brief Shared pressure and inlet correction for non-centrifugal models.
 * @details Compressor power and capacity change when discharge pressure, inlet pressure, and
 *          site atmospheric pressure differ from the rated conditions. Before the operating
 *          point is evaluated, the assessment adjusts the full-load reference power and
 *          airflow to reflect those conditions. Centrifugal compressors use a separate
 *          discharge-pressure curve. For screw compressors, the rated inlet pressure is used
 *          as the pressure-ratio base; for other compressor types, atmospheric pressure is
 *          used as the base.
 *
 * @formula{compressor-assessment-pressure-power;
 *   P_{adj} =
 *   F_P \cdot \frac{P_{atm}}{P_{in}} \cdot BHP_{FL} \cdot
 *   \frac{0.746}{\eta} \cdot R_P
 * }
 * @formula{compressor-assessment-pressure-flow;
 *   Q_{adj} = F_Q \cdot Q_{rated} \cdot \left(1 - 0.00075(P_d - P_{rated})\right)
 * }
 * @formula{compressor-assessment-pressure-ratio;
 *   R_P =
 *   \frac{\left(\frac{P_d + P_b}{P_b}\right)^{(n-1)/n} - 1}
 *        {\left(\frac{P_{rated} + P_{in,rated}}{P_{in,rated}}\right)^{(n-1)/n} - 1}
 * }
 *
 * The empirical atmospheric correction factors are used when the pressure adjustment is
 * enabled. They account for the effect of site atmospheric pressure on power and airflow:
 * @formula{compressor-assessment-pressure-factor-power;
 *   F_P = -0.0000577P_{atm}^3 + 0.000251P_{atm}^2 + 0.0466P_{atm} + 0.4442
 * }
 * @formula{compressor-assessment-pressure-factor-flow;
 *   F_Q = 0.000258P_{atm}^3 - 0.0116P_{atm}^2 + 0.176P_{atm} + 0.09992
 * }
 *
 * @subheading{Symbols}
 * @symtable
 * @symrow{P_{adj}; Adjusted package power; \kilo\watt}
 * @symrow{Q_{adj}; Adjusted airflow; \acfm}
 * @symrow{F_P; Atmospheric pressure correction for power; \unitless}
 * @symrow{F_Q; Atmospheric pressure correction for airflow; \unitless}
 * @symrow{P_{atm}; Atmospheric pressure; \psia}
 * @symrow{P_{in}; Measured inlet pressure; \psia}
 * @symrow{BHP_{FL}; Full-load brake horsepower; \hp}
 * @symrow{0.746; Horsepower-to-kilowatt conversion; \kilo\watt\per\hp}
 * @symrow{\eta; Motor efficiency; \unitless}
 * @symrow{R_P; Polytropic pressure-ratio correction; \unitless}
 * @symrow{Q_{rated}; Rated airflow capacity; \acfm}
 * @symrow{P_d; Operating discharge pressure; \psig}
 * @symrow{P_{rated}; Rated discharge pressure; \psig}
 * @symrow{P_b; Pressure-ratio base pressure; \psia}
 * @symrow{P_{in,rated}; Rated inlet pressure; \psia}
 * @symrow{n; Polytropic exponent; \unitless}
 * @endsymtable
 */
