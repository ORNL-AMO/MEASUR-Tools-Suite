/**
 * @defgroup modulation_without_unload_compressor_assessment Modulation Without Unload Compressor
 * @ingroup compressor_control_models
 * @brief Compressor model for inlet modulation without unloading.
 * @details Inlet modulation reduces compressor capacity by throttling the inlet, but the
 *          package power does not fall in direct proportion to airflow. Even at low flow, the
 *          compressor can still use a substantial share of full-load power. The model
 *          represents that behavior with a curved relationship between no-load power and
 *          full-load power.
 *
 * In load/unload assessments, the same curve shape is also used for the portion of operation
 * where the compressor is still loaded and modulating. In that case, the lower anchor is the
 * maximum modulating power floor rather than true no-load power.
 *
 * @heading{Power and Airflow Fractions}
 * @copydoc modulation_without_unload_formula
 */

/**
 * @defgroup modulation_without_unload_formula Modulation Without Unload Formula
 * @ingroup modulation_without_unload_compressor_assessment
 * @brief Power-law relationship between airflow fraction and package power.
 * @details When airflow is the known quantity, the curve estimates the required package
 *          power. When measured power is the known quantity, the same curve is inverted to
 *          estimate airflow. The exponent controls how strongly power stays elevated as
 *          airflow is reduced.
 *
 * @formula{mod-without-unload-power-from-airflow;
 *   P = (P_{FL} - P_{NL})f_Q^m + P_{NL}
 * }
 * @formula{mod-without-unload-airflow-from-power;
 *   Q = Q_{FL}\left(\frac{f_PP_{FL} - P_{NL}}{P_{FL} - P_{NL}}\right)^{1/m}
 * }
 *
 * For the loaded modulation portion of a load/unload assessment, the power floor is the
 * maximum modulating power and the upper anchor is the maximum package power:
 * @formula{mod-without-unload-loaded-modulation-power-from-airflow;
 *   P = (P_{max} - P_{max,mod})f_Q^m + P_{max,mod}
 * }
 * @formula{mod-without-unload-loaded-modulation-airflow-from-power;
 *   Q = Q_{FL}\left(\frac{f_PP_{FL} - P_{max,mod}}{P_{max} - P_{max,mod}}\right)^{1/m}
 * }
 *
 * @subheading{Symbols}
 * @symtable
 * @symrow{P; Calculated package power; \kilo\watt}
 * @symrow{Q; Calculated airflow; \acfm}
 * @symrow{P_{FL}; Full-load package power; \kilo\watt}
 * @symrow{Q_{FL}; Full-load airflow; \acfm}
 * @symrow{P_{NL}; No-load package power; \kilo\watt}
 * @symrow{P_{max}; Maximum package power in the loaded modulation region; \kilo\watt}
 * @symrow{P_{max,mod}; Maximum modulating power floor; \kilo\watt}
 * @symrow{f_P; Fraction of full-load power; \unitless}
 * @symrow{f_Q; Fraction of full-load airflow; \unitless}
 * @symrow{m; Modulation exponent; \unitless}
 * @endsymtable
 */
