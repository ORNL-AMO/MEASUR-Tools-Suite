/**
 * @defgroup centrifugal_compressor_assessment Centrifugal Compressors
 * @ingroup compressor_control_models
 * @brief Centrifugal load/unload, modulation/unload, and blow-off compressor calculations.
 * @details Centrifugal compressors are modeled with control curves that relate package power
 *          to useful delivered airflow. The standard results are package power, delivered
 *          airflow, power fraction, and airflow fraction. Blow-off control also reports the
 *          airflow being compressed and vented rather than delivered to useful demand.
 *
 *          Discharge-pressure adjustment is based on the compressor pressure-capacity curve.
 *          A smooth second-order curve is fit through the catalog pressure and capacity
 *          points, then evaluated at the requested full-load and maximum-flow pressures.
 *
 * @heading{Load/Unload}
 * @copydoc centrifugal_load_unload_formula
 *
 * @heading{Modulation With Unload}
 * @copydoc centrifugal_modulation_unload_formula
 *
 * @heading{Blow-Off}
 * @copydoc centrifugal_blowoff_formula
 */

/**
 * @defgroup centrifugal_load_unload_formula Centrifugal Load/Unload Formula
 * @ingroup centrifugal_compressor_assessment
 * @brief Linear relationship between no-load and full-load power.
 * @details For centrifugal load/unload control, the model treats the operating curve as a
 *          straight line between no-load power and full-load power. As useful airflow moves
 *          from zero to full load, the package power moves proportionally between those two
 *          anchors.
 *
 * @formula{centrifugal-load-unload-airflow-from-power;
 *   f_Q = (f_P - f_{P,NL})\frac{1}{1 - f_{P,NL}}
 * }
 * @formula{centrifugal-load-unload-power-from-airflow;
 *   f_P = (1 - f_{P,NL})f_Q + f_{P,NL}
 * }
 *
 * @subheading{Symbols}
 * @symtable
 * @symrow{f_P; Fraction of full-load power; \unitless}
 * @symrow{f_Q; Fraction of full-load airflow; \unitless}
 * @symrow{f_{P,NL}; No-load power divided by full-load power; \unitless}
 * @endsymtable
 */

/**
 * @defgroup centrifugal_modulation_unload_formula Centrifugal Modulation/Unload Formula
 * @ingroup centrifugal_compressor_assessment
 * @brief Piecewise model through no-load, unload, full-load, and maximum-flow points.
 * @details Modulation/unload control uses two straight segments. At low power, the model
 *          interpolates from no-load to the unload point. Above the unload point, it
 *          interpolates through the higher-flow portion of the curve up to the maximum-flow
 *          operating point.
 *
 * @formula{centrifugal-mod-unload-low;
 *   f_Q = (f_P - f_{P,NL})\frac{f_{Q,UL}}{f_{P,UL} - f_{P,NL}}
 *   \quad \text{for } f_P < f_{P,UL}
 * }
 * @formula{centrifugal-mod-unload-high;
 *   f_Q = f_P\frac{1 - f_{Q,base}}{1 - f_{P,UL}} +
 *         1 - \frac{1 - f_{Q,base}}{1 - f_{P,UL}}
 *   \quad \text{for } f_P \ge f_{P,UL}
 * }
 *
 * @subheading{Symbols}
 * @symtable
 * @symrow{f_{P,NL}; No-load power fraction; \unitless}
 * @symrow{f_{P,UL}; Unload power fraction; \unitless}
 * @symrow{f_{Q,UL}; Unload airflow divided by full-load airflow; \unitless}
 * @symrow{f_{Q,base}; Unload airflow divided by maximum airflow; \unitless}
 * @endsymtable
 */

/**
 * @defgroup centrifugal_blowoff_formula Centrifugal Blow-Off Formula
 * @ingroup centrifugal_compressor_assessment
 * @brief Useful airflow and blow-off airflow for centrifugal blow-off control.
 * @details Blow-off control keeps the compressor operating while venting part of the
 *          compressed air. The model separates produced airflow from useful delivered
 *          airflow. Below the blow-off power point, useful airflow is the produced airflow
 *          fraction minus the blow-off fraction. Above that point, useful airflow follows a
 *          straight line from the blow-off point to full load.
 *
 * @formula{centrifugal-blowoff-low;
 *   f_Q = f_{Q,BO} - f_{BO}
 *   \quad \text{for } f_P \le f_{P,BO}
 * }
 * @formula{centrifugal-blowoff-high;
 *   f_Q = \frac{1 - f_{Q,BO}}{1 - f_{P,BO}}
 *         \left(f_P - 1 + \frac{1 - f_{P,BO}}{1 - f_{Q,BO}}\right)
 *   \quad \text{for } f_P > f_{P,BO}
 * }
 * @formula{centrifugal-blowoff-airflow;
 *   Q_{BO} = (f_{Q,BO} - f_Q)Q_{FL}
 * }
 *
 * @subheading{Symbols}
 * @symtable
 * @symrow{f_{P,BO}; Blow-off package power divided by full-load power; \unitless}
 * @symrow{f_{Q,BO}; Blow-off airflow divided by full-load airflow; \unitless}
 * @symrow{f_{BO}; User-specified blow-off fraction; \unitless}
 * @symrow{Q_{BO}; Calculated blow-off airflow; \acfm}
 * @symrow{Q_{FL}; Full-load airflow; \acfm}
 * @endsymtable
 */
