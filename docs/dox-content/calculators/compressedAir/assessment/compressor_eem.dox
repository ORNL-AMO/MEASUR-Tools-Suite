/**
 * @defgroup compressor_eem_assessment Compressor Energy Efficiency Measures
 * @ingroup compressor_assessment_modeling
 * @brief Compressor EEM calculations for leaks, end-use efficiency, pressure, set points, and savings.
 * @details Energy efficiency measure calculations estimate how a proposed compressed-air
 *          improvement changes airflow, pressure, power, energy, and cost. These calculations
 *          do not decide whether a measure is practical or appropriate for a site. They
 *          quantify the expected numerical change after the reduction amount, pressure change,
 *          or operating schedule has been defined.
 *
 * @heading{Leak Reduction}
 * @copydoc compressor_eem_leak_formula
 *
 * @heading{End-Use Efficiency}
 * @copydoc compressor_eem_end_use_formula
 *
 * @heading{Pressure Reduction and Set Points}
 * @copydoc compressor_eem_pressure_formula
 *
 * @heading{Reusable Profile Transforms}
 * @copydoc compressor_eem_profile_transform_formula
 *
 * @heading{Savings}
 * @copydoc compressor_eem_savings_formula
 */

/**
 * @defgroup compressor_eem_leak_formula Compressor EEM Leak Reduction Formula
 * @ingroup compressor_eem_assessment
 * @brief Airflow reduction from repairing compressed-air leaks.
 * @details Leak repair reduces the portion of compressed air that is produced but not used
 *          by productive equipment. The adjusted use airflow subtracts the repaired leak
 *          airflow from the baseline use airflow.
 *
 * @formula{compressor-eem-leak-reduced;
 *   Q_{leak,red} = r_{leak}Q_{leak}
 * }
 * @formula{compressor-eem-leak-use;
 *   Q_{use,adj} = Q_{use} - Q_{leak,red}
 * }
 *
 * @symtable
 * @symrow{Q_{leak,red}; Reduced leak airflow; \acfm}
 * @symrow{r_{leak}; Leak reduction fraction; \unitless}
 * @symrow{Q_{leak}; Baseline leak airflow; \acfm}
 * @symrow{Q_{use,adj}; Adjusted use airflow; \acfm}
 * @symrow{Q_{use}; Baseline use airflow; \acfm}
 * @endsymtable
 */

/**
 * @defgroup compressor_eem_end_use_formula Compressor EEM End-Use Efficiency Formula
 * @ingroup compressor_eem_assessment
 * @brief Adjusted use airflow from end-use efficiency improvements.
 * @details End-use improvements reduce the amount of compressed air required by tools,
 *          processes, or equipment. The model subtracts the average airflow reduction from
 *          the baseline use airflow and then expresses the result as a share of full-load
 *          compressor airflow.
 *
 * @formula{compressor-eem-end-use;
 *   Q_{use,adj} = Q_{use} - Q_{red}
 * }
 * @formula{compressor-eem-end-use-fraction;
 *   f_{use,adj} = \frac{Q_{use,adj}}{Q_{FL}}
 * }
 *
 * @symtable
 * @symrow{Q_{use,adj}; Adjusted use airflow; \acfm}
 * @symrow{Q_{red}; Average airflow reduction; \acfm}
 * @symrow{f_{use,adj}; Adjusted use airflow fraction; \unitless}
 * @symrow{Q_{FL}; Full-load airflow; \acfm}
 * @endsymtable
 */

/**
 * @defgroup compressor_eem_pressure_formula Compressor EEM Pressure Formula
 * @ingroup compressor_eem_assessment
 * @brief Adjusted power and use airflow after pressure changes.
 * @details Lower discharge pressure usually reduces both compressor power and compressed-air
 *          use. The power equation estimates how full-load package power changes with the
 *          absolute pressure ratio. The airflow equation applies the assessment pressure-flow
 *          response factor, which assumes part of the connected demand falls as pressure is
 *          reduced. Pressure-reduction and cascading-set-point measures use the same
 *          equations. The exponent 0.283 is the retained assessment pressure-power
 *          relationship.
 *
 * @formula{compressor-eem-pressure-power;
 *   P_{adj} = P_{FL}
 *   \frac{\left(\frac{P_{adj,FL}+P_{alt}}{P_{alt}}\right)^{0.283} - 1}
 *        {\left(\frac{P_{FL,g}+P_{atm}}{P_{atm}}\right)^{0.283} - 1}
 * }
 * @formula{compressor-eem-pressure-airflow;
 *   Q_{use,adj} = Q_{use} -
 *   \left(Q_{use} - Q_{use}\frac{P_{adj,FL}+P_{alt}}{P_{FL,g}+P_{atm}}\right)0.6
 * }
 *
 * @symtable
 * @symrow{P_{adj}; Adjusted full-load power; \kilo\watt}
 * @symrow{P_{FL}; Baseline full-load power; \kilo\watt}
 * @symrow{P_{adj,FL}; Adjusted full-load gauge pressure; \psig}
 * @symrow{P_{FL,g}; Baseline full-load gauge pressure; \psig}
 * @symrow{P_{alt}; Altitude pressure; \psia}
 * @symrow{P_{atm}; Atmospheric pressure; \psia}
 * @symrow{Q_{use,adj}; Adjusted use airflow; \acfm}
 * @symrow{Q_{use}; Baseline use airflow; \acfm}
 * @symrow{0.6; Legacy pressure-flow response factor; \unitless}
 * @endsymtable
 */

/**
 * @defgroup compressor_eem_profile_transform_formula Compressor EEM Profile Transform Formula
 * @ingroup compressor_eem_assessment
 * @brief Pressure, receiver, and automatic sequencer transforms for profile EEMs.
 * @details Profile-level pressure measures use the same pressure-reduced airflow relationship
 *          as scalar pressure measures. Adding receiver volume increases the total storage
 *          volume by the added amount. Automatic sequencer settings create a lower and upper
 *          pressure target around the desired system target pressure.
 *
 * @formula{compressor-eem-pressure-reduced-airflow;
 *   Q_{adj} = Q_{use} -
 *   \left(Q_{use} - Q_{use}\frac{P_{adj}+P_{alt}}{P_{orig}+P_{atm}}\right)0.6
 * }
 * @formula{compressor-eem-receiver-volume;
 *   V_{total} = V_{current} + V_{add}
 * }
 * @formula{compressor-eem-sequencer-low;
 *   P_{FL,seq} = P_{target} - \Delta P
 * }
 * @formula{compressor-eem-sequencer-high;
 *   P_{upper,seq} = P_{target} + \Delta P
 * }
 *
 * @symtable
 * @symrow{Q_{adj}; Pressure-adjusted use airflow; \acfm}
 * @symrow{Q_{use}; Baseline use airflow; \acfm}
 * @symrow{P_{adj}; Adjusted full-load pressure; \psig}
 * @symrow{P_{orig}; Original full-load pressure; \psig}
 * @symrow{P_{alt}; Site altitude pressure; \psia}
 * @symrow{P_{atm}; Atmospheric pressure; \psia}
 * @symrow{0.6; Legacy pressure-flow response factor; \unitless}
 * @symrow{V_{total}; Total receiver volume after addition; \cubicFoot}
 * @symrow{V_{current}; Current receiver volume; \cubicFoot}
 * @symrow{V_{add}; Added receiver volume; \cubicFoot}
 * @symrow{P_{FL,seq}; Sequencer full-load pressure; \psig}
 * @symrow{P_{upper,seq}; Sequencer upper pressure; \psig}
 * @symrow{P_{target}; Sequencer target pressure; \psig}
 * @symrow{\Delta P; Sequencer pressure variance; \psig}
 * @endsymtable
 */

/**
 * @defgroup compressor_eem_savings_formula Compressor EEM Savings Formula
 * @ingroup compressor_eem_assessment
 * @brief Demand, energy, and cost savings from reduced discharge pressure.
 * @details Demand savings are the difference between baseline power and modified power.
 *          Annual energy savings are demand savings multiplied by annual operating hours.
 *          Annual cost savings are energy savings multiplied by the electricity price.
 *
 * @formula{compressor-eem-power-savings;
 *   P_{save} = P_{base} - P_{mod}
 * }
 * @formula{compressor-eem-energy-savings;
 *   E_{save} = P_{save}H
 * }
 * @formula{compressor-eem-cost-savings;
 *   C_{save} = E_{save}C_e
 * }
 *
 * @symtable
 * @symrow{P_{save}; Demand savings; \kilo\watt}
 * @symrow{P_{base}; Baseline adjusted power; \kilo\watt}
 * @symrow{P_{mod}; Modified adjusted power; \kilo\watt}
 * @symrow{E_{save}; Annual energy savings; \kilo\watt\hour}
 * @symrow{H; Annual operating hours; \hour}
 * @symrow{C_{save}; Annual cost savings; \dollar}
 * @symrow{C_e; Electricity cost; \dollar\per\kilo\watt\hour}
 * @endsymtable
 */
